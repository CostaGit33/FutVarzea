# Copie para backend/.env (nunca versione o arquivo real).

# Banco PostgreSQL
DATABASE_URL=postgres://futvarzea:troque-esta-senha@localhost:5432/futvarzea

# Segredo do JWT de acesso. Mínimo de 32 caracteres, aleatório.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Duração dos tokens
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Origens permitidas pelo CORS, separadas por vírgula. Vazio = nenhuma origem de navegador.
CORS_ORIGINS=http://localhost:5173

# Servidor
PORT=3000
# Defina 1 quando houver um proxy reverso na frente (Cloudflare Tunnel, Easypanel).
TRUST_PROXY=0

# Versão dos termos de uso aceitos no cadastro
TERMS_VERSION=2026-11
